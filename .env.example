# Production site URL used for canonical links, Open Graph and the sitemap
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form, sent via Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Inbox(es) that receive enquiries; comma-separate multiple addresses
CONTACT_TO_EMAIL=you@example.com
# Optional sender on a domain verified in Resend. If unset, uses
# onboarding@resend.dev, which only delivers to the Resend account owner's email.
CONTACT_FROM_EMAIL=
